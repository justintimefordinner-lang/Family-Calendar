# All of these are optional. Everything can also be configured in the parent app.
# Port the web server listens on (default 3100)
PORT=3100
# Where the SQLite database and photos live (default ./data)
FC_DATA_DIR=./data
# Google OAuth client (Desktop app type). Can also be entered in Parent app > Settings > Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
